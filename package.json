{
  "name": "openbauth-panel",
  "version": "1.0.0",
  "description": "Sistema de autenticación y autorización con Bun y Hono",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir=dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:seed": "bun run scripts/seed.ts",
    "db:migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "hono": "^3.12.0",
    "@hono/node-server": "^1.3.1",
    "zod": "^3.22.4",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "nodemailer": "^6.9.7",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/nodemailer": "^6.4.14",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "authentication",
    "authorization",
    "bun",
    "hono",
    "oauth",
    "jwt",
    "rbac"
  ],
  "author": "OpenBauth Team",
  "license": "MIT"
}
